#
# focus/swap
#

# Focus The Node In The Given Direction
# Default
# super + {_,shift + }{Left,Down,Up,Right}
#	/bin/bspc node -{f,s} {west,south,north,east}
# Focus window in Vim directions With notification
super + h
   /bin/bspc node -f west

super + j
    /bin/bspc node -f south

super + k
    /bin/bspc node -f north

super + l
    /bin/bspc node -f east

# focus the node for the given path jump
# Default
# super + {p,b,comma,period}
	# /bin/bspc node -f @{parent,brother,first,second}

# # focus the next/previous window in the current desktop
# super + {_,shift + }c
# 	bspc node -f {next,prev}.local.!hidden.window

# focus the next/previous desktop in the current monitor
# super + bracket{left,right}
# 	bspc desktop -f {prev,next}.local

# focus the last node/desktop
# Default
# super + {grave,Tab}
# 	/bin/bspc {node,desktop} -f last

# focus the older or newer node in the focus history
# Default
# super + {o,i}
# 	/bin/bspc wm -h off; \
# 	/bin/bspc node {older,newer} -f; \
# 	/bin/bspc wm -h on

# Focus Or Send To The Given Desktop
super + {_,shift + }{1-9,0}
	/bin/bspc {desktop -f,node -d} '^{1-9,10}'

#
# preselect
#

# preselect the direction
# super + ctrl + alt + {Left,Down,Up,Right}
super + ctrl + {h,j,k,l}
	/bin/bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	/bin/bspc node -o 0.{1-9}

# Cancel The Preselection For The Focused Node
super + ctrl + alt + space
# Recommend: super + ctrl + space
	/bin/bspc node -p cancel

# Cancel The Preselection For The Focused Desktop
# super + ctrl + shift + space
# 	/bin/bspc query -N -d | /bin/xargs -I id -n 1 /bin/bspc node id -p cancel

#
# move/resize
#

# Expand A Window By Moving One Of Its Side Outward
# super + alt + {h,j,k,l}
# 	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Contract A Window By Moving One Of Its Side Inward
# super + alt + shift + {h,j,k,l}
# 	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
# super + shift + {Left,Down,Up,Right}
# super + {h,j,k,l}
# 	/bin/bspc node -v {-20 0,0 20,0 -20,20 0}

# Custom Resize
super + shift + {h,j,k,l}
	~/.config/bspwm/scripts/resize {west,south,north,east}

# Lock the screen using i3lock-color
super + shift + x
    ~/Scripts/lock

