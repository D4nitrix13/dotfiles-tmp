# ------------ Brightness ------------
# nf-md-brightness_7 -> 󰃠
# nf-md-brightness_6 -> 󰃟
# nf-md-brightness_5 -> 󰃞
# nf-md-brightness_4 -> 󰃝    
(( br = $(brightnessctl get) * 100 / 255 ))
echo -n "$(percentage $br 󰃝  󰃞  󰃟  󰃠 ) $br% "
